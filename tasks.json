{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Obadian Hub: start and open",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\start-obadian-hub.ps1"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "obadian-hub",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting Obadian Hub\\.$",
          "endsPattern": "^Obadian Hub is ready\\."
        }
      }
    }
  ]
}
